# Server Port
PORT=8080

# PostgreSQL Connection String (Layerbase / Google Cloud SQL)
# Example: postgres://USER:PASSWORD@tatacrypto-firm-loop.sage.cloud.layerbase.dev:5432/DATABASE_NAME?sslmode=require
DATABASE_URL=

# Set to false only for local PostgreSQL without SSL
DB_SSL=true

# Alchemy / Web3 RPC Endpoints (Configure in Environment Variables / Secrets)
BSC_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# Official TataSwap Protocol Configuration
OFFICIAL_FEE_RECEIVER=0xD9e5c5d0522B1eeE8Ff9bC006F64d53d2C411CA4
LISTING_FEE_USDT=5.0
