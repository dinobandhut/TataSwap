# Server Port
PORT=8080

# PostgreSQL Connection String (Layerbase / Google Cloud SQL)
# Example: postgres://USER:PASSWORD@tatacrypto-firm-loop.sage.cloud.layerbase.dev:5432/DATABASE_NAME?sslmode=require
DATABASE_URL=

# Set to false only for local PostgreSQL without SSL
DB_SSL=true

# Mainnet Web3 RPC Endpoints (Configure in Environment Variables / Secrets)
TATA_RPC_URL=https://rpctata.duckdns.org/rpc
ETH_RPC_URL=https://public.1rpc.io/eth
BSC_RPC_URL=https://public.1rpc.io/bnb
POLYGON_RPC_URL=https://public.1rpc.io/matic
CORE_RPC_URL=https://rpc.coredao.org

# Official TataSwap Protocol Configuration
OFFICIAL_FEE_RECEIVER=0xD9e5c5d0522B1eeE8Ff9bC006F64d53d2C411CA4
LISTING_FEE_USDT=5.0

# Optional: Reown / WalletConnect Cloud Project ID (enables WalletConnect QR modal in Chrome)
WALLETCONNECT_PROJECT_ID=
